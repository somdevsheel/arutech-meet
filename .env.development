# ==============================================================================
# Arutech Meet — Environment Configuration
# Copy this file to .env for local development (docker-compose reads .env).
# NEVER commit real secrets. Generate strong random values for every *_SECRET.
# ==============================================================================

# --- Runtime ---
NODE_ENV=development

# --- Database (PostgreSQL / Prisma) ---
DATABASE_URL=postgresql://arutech:arutech_dev_password@localhost:5432/arutech_meet?schema=public

# --- Cache / Realtime (Redis) ---
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=arutech

# --- Auth / JWT ---
JWT_SECRET=change-me-access-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=change-me-cookie-signing-secret

# --- API server ---
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Object Storage (S3 / MinIO) ---
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=arutech-meet-dev
S3_ACCESS_KEY=arutech_minio
S3_SECRET_KEY=arutech_minio_secret
S3_FORCE_PATH_STYLE=true

# --- Media Server (LiveKit SFU) ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_HTTP_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-livekit-secret-min-32-chars

# --- Email (SMTP) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Arutech Meet <no-reply@arutech.dev>"
SMTP_SECURE=false

# --- OAuth (prepared, optional in dev) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- AI Providers (prepared, optional in dev) ---
AI_PROVIDER=openai
OPENAI_API_KEY=
TRANSCRIPTION_PROVIDER=openai

# --- Push Notifications (prepared, optional in dev) ---
FCM_SERVICE_ACCOUNT_JSON=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=

# --- Observability (prepared, optional in dev) ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=debug

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- Web app (Next.js public) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
