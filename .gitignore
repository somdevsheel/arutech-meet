# Dependencies
node_modules/
.pnp
.pnp.js
.pnpm-store/
.npm-cache/

# Build outputs
dist/
build/
.next/
out/
*.tsbuildinfo
.turbo/

# Env — catch-all (not just the exact ".env"/".env.*.local" filenames the
# previous version of this pattern matched, which would have silently let a
# real secrets file through if named anything else, e.g. ".env.production" or
# ".env.lightsail" — see docs/deployment-lightsail.md). Only the checked-in
# templates below are exempted.
.env*
!.env.example
!.env.development
!.env.test
!.env.production.example

# Testing
coverage/
playwright-report/
test-results/

# Prisma
packages/database/generated/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/*
!.vscode/extensions.json
.idea/

# Mobile
apps/mobile/ios/Pods/
apps/mobile/ios/build/
apps/mobile/android/.gradle/
apps/mobile/android/build/
apps/mobile/android/app/build/
apps/mobile/android/app/.cxx/
apps/mobile/android/local.properties
apps/mobile/.expo/

# Docker volumes / local storage
infrastructure/docker/volumes/
minio-data/

# Recordings (local dev)
services/recording/tmp/
