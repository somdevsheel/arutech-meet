# ==============================================================================
# Arutech Meet — Environment Configuration
# Copy this file to .env for local development (docker-compose reads .env).
# NEVER commit real secrets. Generate strong random values for every *_SECRET.
# ==============================================================================

# --- Runtime ---
NODE_ENV=production

# --- Database (PostgreSQL / Prisma) ---
DATABASE_URL=postgresql://USER:PASSWORD@PROD_DB_HOST:5432/arutech_meet?schema=public&sslmode=require

# --- Cache / Realtime (Redis) ---
REDIS_URL=rediss://PROD_REDIS_HOST:6379
REDIS_PREFIX=arutech

# --- Auth / JWT ---
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# --- API server ---
API_PORT=4000
API_URL=https://api.arutech.example.com
WEB_URL=https://meet.arutech.example.com
CORS_ORIGINS=https://meet.arutech.example.com

# --- Object Storage (S3 / MinIO) ---
S3_ENDPOINT=https://s3.amazonaws.com
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=arutech-meet-prod
S3_ACCESS_KEY=REPLACE_WITH_IAM_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_IAM_SECRET_KEY
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_URL=https://cdn.arutech.example.com

# --- Media Server (LiveKit SFU) ---
LIVEKIT_URL=wss://livekit.arutech.example.com
LIVEKIT_HTTP_URL=https://livekit.arutech.example.com
LIVEKIT_API_KEY=REPLACE_WITH_LIVEKIT_KEY
LIVEKIT_API_SECRET=REPLACE_WITH_LIVEKIT_SECRET

# --- Email (SMTP) ---
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Arutech Meet <no-reply@arutech.dev>"
SMTP_SECURE=true

# --- OAuth (prepared, optional in dev) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- AI Providers (prepared, optional in dev) ---
AI_PROVIDER=openai
OPENAI_API_KEY=
TRANSCRIPTION_PROVIDER=openai

# --- Push Notifications (prepared, optional in dev) ---
FCM_SERVICE_ACCOUNT_JSON=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=

# --- Observability (prepared, optional in dev) ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=info

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- Web app (Next.js public) ---
NEXT_PUBLIC_API_URL=https://api.arutech.example.com
NEXT_PUBLIC_WS_URL=wss://api.arutech.example.com
NEXT_PUBLIC_LIVEKIT_URL=wss://livekit.arutech.example.com
